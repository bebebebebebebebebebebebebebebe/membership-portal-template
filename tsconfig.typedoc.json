{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/types/**/*.ts",
    "src/types/**/*.tsx",
    "src/config/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "docs/code-reference",
    "src/app",
    "src/testing",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
