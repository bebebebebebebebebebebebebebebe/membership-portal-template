{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "expand",
  "entryPoints": [
    "src/features",
    "src/lib",
    "src/types"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "out": "docs/code-reference",
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/testing/**",
    "src/app/**"
  ],
  "excludePrivate": false,
  "excludeInternal": true,
  "excludeExternals": false
}
